[Unit]
Description=Create NVIDIA device nodes and generate CDI specification
After=reefy-storage.service systemd-modules-load.service
Wants=reefy-storage.service
# Must produce /var/run/cdi/nvidia.yaml before reefy-control's reconciler
# runs `docker compose up` for any gpu:true app. Without this ordering,
# both units start in parallel after reefy-storage and the reconciler
# can win the race - docker then fails with "CDI device injection
# failed: unresolvable CDI devices nvidia.com/gpu=all" until the next
# state apply (which on systems without periodic re-applies means GPU
# stays broken until the user touches something). Ordering only (no
# Requires) so non-NVIDIA hosts where nvidia-cdi-setup.sh exits 0 as a
# no-op don't block reefy-control either.
Before=reefy-control.service

[Service]
Type=oneshot
Environment="LD_LIBRARY_PATH=/usr/lib"
ExecStart=/usr/bin/nvidia-cdi-setup.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
