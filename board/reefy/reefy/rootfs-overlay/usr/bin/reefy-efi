#!/bin/sh
# reefy-efi - Unified EFI boot entry and firmware management
#
# Commands:
#   reefy-efi fix                    Verify/fix EFI entries + boot order
#   reefy-efi update <efi-file> [-r] A/B firmware update with BootNext
#   reefy-efi confirm                Commit current slot as default (swap BootOrder)
#   reefy-efi set-next <a|b>         Set one-shot next boot slot
#   reefy-efi status                 Show current slot info
#
# All commands are idempotent and self-healing:
# - Remove duplicate/stale EFI entries
# - Recreate missing entries with correct PARTUUIDs
# - Fix boot order (reefy entries first)
#
# Run under errexit: an unhandled failure aborts the operation instead of
# limping on in a half-applied state. pipefail is cleared (in case a
# parent shell enabled it) - several commands pipe into grep/awk where a
# no-match is normal, not an error. Cleanup traps must stay errexit-safe
# (see cmd_update's EXIT trap) so a failing cleanup can't poison the exit
# code after a successful operation.
set -e
set +o pipefail 2>/dev/null || true

REEFY_MNT="/mnt/reefy"

# ── Helpers ──

die() { echo "Error: $1" >&2; exit 1; }

die_after_efivar_cleanup() {
    mount -o remount,ro /sys/firmware/efi/efivars 2>/dev/null || true
    die "$1"
}

# Extract the 4-digit boot number for an entry whose label matches $1.
# Tolerant of efibootmgr output that may or may not include the active
# asterisk after the boot number (depends on firmware/efivars state).
# Prints the number (e.g. "0004") or empty string if not found.
boot_num_for_label() {
    LABEL="$1"
    efibootmgr 2>/dev/null \
        | grep -E "^Boot[0-9A-Fa-f]{4}\*?[[:space:]]+${LABEL}([[:space:]]|$)" \
        | sed -E 's/^Boot([0-9A-Fa-f]{4}).*/\1/' \
        | head -1
}

# Extract all 4-digit boot numbers for entries whose label and device path
# match the expected PARTUUID. Prints one number per line.
boot_nums_for_label_guid() {
    LABEL="$1"
    GUID="$2"
    efibootmgr -v 2>/dev/null \
        | grep -E "^Boot[0-9A-Fa-f]{4}\*?[[:space:]]+${LABEL}[[:space:]]" \
        | grep -i -- "$GUID" \
        | sed -E 's/^Boot([0-9A-Fa-f]{4})\*?.*/\1/'
}

# Return the entry in $2 that is not present in $1. Both arguments are
# newline-separated Boot#### numbers without the "Boot" prefix.
new_boot_num_from_sets() {
    OLD_SET="$1"
    NEW_SET="$2"
    for NUM in $NEW_SET; do
        FOUND=0
        for OLD_NUM in $OLD_SET; do
            if [ "$NUM" = "$OLD_NUM" ]; then
                FOUND=1
                break
            fi
        done
        [ "$FOUND" -eq 0 ] && echo "$NUM" && return 0
    done
    return 1
}

# Find the reefy boot disk from what's mounted at /mnt/reefy. The
# supported hardware shape is USB-boot (sda); EC2 / mmcblk / NVMe-boot
# is exotic but the tool works on them too once part_dev() handles the
# kernel's partition-name separator rule.
# Sets: MOUNTED_DEV, DISK
find_disk() {
    MOUNTED_DEV=$(findmnt -n -o SOURCE "$REEFY_MNT" 2>/dev/null) || true
    [ -z "$MOUNTED_DEV" ] && return 1
    if [ -n "${REEFY_EFI_TEST_DISK:-}" ]; then
        DISK="$REEFY_EFI_TEST_DISK"
        return 0
    fi
    DISK="/dev/$(lsblk -no PKNAME "$MOUNTED_DEV" 2>/dev/null)"
    [ -b "$DISK" ] || return 1
}

# Build the kernel partition device path for the given disk + partition
# number. The kernel inserts a 'p' separator when the disk name ends in
# a digit (NVMe: nvme0n1 -> nvme0n1p1; mmcblk: mmcblk0 -> mmcblk0p1) and
# omits it when it ends in a letter (SATA/USB: sda -> sda1). Without
# this the calling code produced names like /dev/nvme0n11 that don't
# exist on disk.
part_dev() {
    DISKARG="$1"
    PARTNUM="$2"
    case "$DISKARG" in
        *[0-9]) echo "${DISKARG}p${PARTNUM}" ;;
        *)      echo "${DISKARG}${PARTNUM}" ;;
    esac
}

# Resolve active/inactive slots
# Sets: ACTIVE_LABEL, INACTIVE_LABEL, INACTIVE_PART, INACTIVE_DEV, CURRENT_BOOTNUM
resolve_slots() {
    find_disk || die "$REEFY_MNT not mounted"

    CURRENT_BOOTNUM=$(efibootmgr 2>/dev/null | grep '^BootCurrent:' | awk '{print $2}')

    # Always resolve from what's mounted - BootCurrent can be a transient entry
    # that doesn't match the mounted ESP (e.g., after USB swap or UEFI quirks)
    if [ "$MOUNTED_DEV" = "$(part_dev "$DISK" 1)" ]; then
        ACTIVE_LABEL="reefy-a"
        INACTIVE_LABEL="reefy-b"
        INACTIVE_PART=2
    else
        ACTIVE_LABEL="reefy-b"
        INACTIVE_LABEL="reefy-a"
        INACTIVE_PART=1
    fi

    INACTIVE_DEV="$(part_dev "$DISK" "$INACTIVE_PART")"
}

# Verify and fix all EFI boot entries. Idempotent.
# - Remove duplicates (UEFI auto-created entries pointing to our partitions)
# - Remove stale reefy-a/reefy-b entries (wrong PARTUUIDs from old USB)
# - Create missing reefy-a/reefy-b entries
# - Fix boot order (reefy entries first)
fix_entries() {
    find_disk || die "$REEFY_MNT not mounted"

    GUID_A=$(blkid -s PARTUUID -o value "$(part_dev "$DISK" 1)" 2>/dev/null)
    GUID_B=$(blkid -s PARTUUID -o value "$(part_dev "$DISK" 2)" 2>/dev/null)

    mount -o remount,rw /sys/firmware/efi/efivars 2>/dev/null || true

    # Remove UEFI auto-created entries that point to our partitions but aren't reefy-a/reefy-b.
    # Asterisk on the Boot#### line marks entry as "active"; some firmwares
    # leave stale entries inactive and efibootmgr renders them without '*'.
    # Match both forms so leftover inactive entries can be cleaned up.
    efibootmgr 2>/dev/null | grep -E '^Boot[0-9A-Fa-f]+\*?[[:space:]]' | while read -r line; do
        BOOTNUM=$(echo "$line" | sed -E 's/^Boot([0-9A-Fa-f]+)\*?.*/\1/')
        LABEL=$(echo "$line" | sed -E 's/^Boot[0-9A-Fa-f]+\*?[[:space:]]+//' | awk '{print $1}')
        [ "$LABEL" = "reefy-a" ] && continue
        [ "$LABEL" = "reefy-b" ] && continue
        ENTRY_DETAIL=$(efibootmgr -v 2>/dev/null | grep -E "^Boot${BOOTNUM}\*?[[:space:]]")
        if echo "$ENTRY_DETAIL" | grep -qi "${GUID_A}\|${GUID_B}" 2>/dev/null; then
            efibootmgr -b "$BOOTNUM" -B 2>/dev/null || true
            echo "[reefy-efi] Removed duplicate entry: Boot${BOOTNUM} (${LABEL})"
        fi
    done

    # Remove stale reefy-a/reefy-b entries whose device path doesn't match
    # the expected PARTUUID for that label. Detects three pathologies:
    #   - Wrong disk (USB swap): device path points at some other PARTUUID
    #   - Label/partition mismatch: entry labeled reefy-a but pointing at
    #     reefy-b's partition (or vice versa). Usually leftover from a
    #     failed/interrupted fix_entries run.
    #   - No device path at all: VenHw-only stub that firmware can't boot.
    # Iterates over ALL entries with the label so duplicates get cleaned up.
    for REEFY_LABEL in reefy-a reefy-b; do
        if [ "$REEFY_LABEL" = "reefy-a" ]; then
            EXPECTED_GUID="$GUID_A"
        else
            EXPECTED_GUID="$GUID_B"
        fi
        # `[[:space:]]+` between Boot#### and label - inactive entries
        # have two spaces where active entries have `* ` (asterisk +
        # space), so a literal single space would miss them.
        efibootmgr -v 2>/dev/null \
            | grep -E "^Boot[0-9A-Fa-f]+\*?[[:space:]]+${REEFY_LABEL}[[:space:]]" \
            | while IFS= read -r REEFY_ENTRY; do
                REEFY_NUM=$(echo "$REEFY_ENTRY" | sed -E 's/^Boot([0-9A-Fa-f]+)\*?.*/\1/')
                if ! echo "$REEFY_ENTRY" | grep -qi "${EXPECTED_GUID}" 2>/dev/null; then
                    efibootmgr -b "$REEFY_NUM" -B 2>/dev/null || true
                    echo "[reefy-efi] Removed stale entry: Boot${REEFY_NUM} (${REEFY_LABEL})"
                fi
            done
    done

    # Create missing entries
    if ! efibootmgr 2>/dev/null | grep -q "reefy-a"; then
        efibootmgr -c -d "$DISK" -p 1 -L "reefy-a" -l '\EFI\Boot\bootx64.efi' 2>/dev/null || true
        echo "[reefy-efi] Created entry: reefy-a"
    fi
    if ! efibootmgr 2>/dev/null | grep -q "reefy-b"; then
        efibootmgr -c -d "$DISK" -p 2 -L "reefy-b" -l '\EFI\Boot\bootx64.efi' 2>/dev/null || true
        echo "[reefy-efi] Created entry: reefy-b"
    fi

    # Fix boot order: reefy entries must be first
    REEFY_A_NUM=$(boot_num_for_label reefy-a)
    REEFY_B_NUM=$(boot_num_for_label reefy-b)
    if [ -n "$REEFY_A_NUM" ] && [ -n "$REEFY_B_NUM" ]; then
        CURRENT_ORDER=$(efibootmgr 2>/dev/null | grep '^BootOrder:' | awk '{print $2}')
        FIRST=$(echo "$CURRENT_ORDER" | cut -d, -f1)
        if [ "$FIRST" != "$REEFY_A_NUM" ] && [ "$FIRST" != "$REEFY_B_NUM" ]; then
            efibootmgr -o "${REEFY_A_NUM},${REEFY_B_NUM}" 2>/dev/null || true
            echo "[reefy-efi] Set BootOrder: ${REEFY_A_NUM},${REEFY_B_NUM}"
        fi
    fi

    mount -o remount,ro /sys/firmware/efi/efivars 2>/dev/null || true
}

# Commit the currently booted slot by replacing the Reefy boot entries with
# freshly allocated Boot#### numbers. Some firmware keeps a hidden/default BBS
# order outside standard BootOrder; recreating entries causes that firmware
# state to follow the new standard order on the next boot.
commit_current_slot_with_fresh_entries() {
    resolve_slots
    fix_entries

    GUID_A=$(blkid -s PARTUUID -o value "$(part_dev "$DISK" 1)" 2>/dev/null)
    GUID_B=$(blkid -s PARTUUID -o value "$(part_dev "$DISK" 2)" 2>/dev/null)
    [ -n "$GUID_A" ] || die "Could not resolve PARTUUID for $(part_dev "$DISK" 1)"
    [ -n "$GUID_B" ] || die "Could not resolve PARTUUID for $(part_dev "$DISK" 2)"

    OLD_A_SET=$(boot_nums_for_label_guid reefy-a "$GUID_A" || true)
    OLD_B_SET=$(boot_nums_for_label_guid reefy-b "$GUID_B" || true)
    OLD_A_COUNT=$(printf '%s\n' "$OLD_A_SET" | grep -c . || true)
    OLD_B_COUNT=$(printf '%s\n' "$OLD_B_SET" | grep -c . || true)
    [ "$OLD_A_COUNT" -eq 1 ] || die "Expected exactly one valid reefy-a entry, found ${OLD_A_COUNT}"
    [ "$OLD_B_COUNT" -eq 1 ] || die "Expected exactly one valid reefy-b entry, found ${OLD_B_COUNT}"

    OLD_A="$OLD_A_SET"
    OLD_B="$OLD_B_SET"

    mount -o remount,rw /sys/firmware/efi/efivars 2>/dev/null || true

    if ! efibootmgr -c -d "$DISK" -p 1 -L "reefy-a" -l '\EFI\Boot\bootx64.efi' 2>/dev/null; then
        die_after_efivar_cleanup "Could not create fresh reefy-a boot entry"
    fi

    AFTER_A_SET=$(boot_nums_for_label_guid reefy-a "$GUID_A" || true)
    NEW_A=$(new_boot_num_from_sets "$OLD_A_SET" "$AFTER_A_SET") || die_after_efivar_cleanup "Could not identify newly created reefy-a entry"

    if ! efibootmgr -c -d "$DISK" -p 2 -L "reefy-b" -l '\EFI\Boot\bootx64.efi' 2>/dev/null; then
        efibootmgr -b "$NEW_A" -B 2>/dev/null || true
        die_after_efivar_cleanup "Could not create fresh reefy-b boot entry"
    fi

    AFTER_B_SET=$(boot_nums_for_label_guid reefy-b "$GUID_B" || true)
    NEW_B=$(new_boot_num_from_sets "$OLD_B_SET" "$AFTER_B_SET") || {
        efibootmgr -b "$NEW_A" -B 2>/dev/null || true
        die_after_efivar_cleanup "Could not identify newly created reefy-b entry"
    }

    if [ "$ACTIVE_LABEL" = "reefy-a" ]; then
        NEW_ACTIVE="$NEW_A"
        NEW_INACTIVE="$NEW_B"
    else
        NEW_ACTIVE="$NEW_B"
        NEW_INACTIVE="$NEW_A"
    fi

    if ! efibootmgr -o "${NEW_ACTIVE},${NEW_INACTIVE}" 2>/dev/null; then
        efibootmgr -b "$NEW_A" -B 2>/dev/null || true
        efibootmgr -b "$NEW_B" -B 2>/dev/null || true
        die_after_efivar_cleanup "Could not set BootOrder to Boot${NEW_ACTIVE},Boot${NEW_INACTIVE}"
    fi

    # Delete the old entries by exact Boot#### number. The new entries are
    # already first in BootOrder, so a deletion failure leaves a bootable order.
    efibootmgr -b "$OLD_A" -B 2>/dev/null || true
    efibootmgr -b "$OLD_B" -B 2>/dev/null || true
    sync

    FINAL_A_SET=$(boot_nums_for_label_guid reefy-a "$GUID_A" || true)
    FINAL_B_SET=$(boot_nums_for_label_guid reefy-b "$GUID_B" || true)
    FINAL_A_COUNT=$(printf '%s\n' "$FINAL_A_SET" | grep -c . || true)
    FINAL_B_COUNT=$(printf '%s\n' "$FINAL_B_SET" | grep -c . || true)
    [ "$FINAL_A_COUNT" -eq 1 ] || die "Expected one final reefy-a entry, found ${FINAL_A_COUNT}"
    [ "$FINAL_B_COUNT" -eq 1 ] || die "Expected one final reefy-b entry, found ${FINAL_B_COUNT}"
    [ "$FINAL_A_SET" = "$NEW_A" ] || die "Final reefy-a entry is Boot${FINAL_A_SET}, wanted Boot${NEW_A}"
    [ "$FINAL_B_SET" = "$NEW_B" ] || die "Final reefy-b entry is Boot${FINAL_B_SET}, wanted Boot${NEW_B}"

    FINAL_ORDER=$(efibootmgr 2>/dev/null | grep '^BootOrder:' | awk '{print $2}')
    FINAL_FIRST=$(echo "$FINAL_ORDER" | cut -d, -f1)
    FINAL_SECOND=$(echo "$FINAL_ORDER" | cut -d, -f2)
    [ "$FINAL_FIRST" = "$NEW_ACTIVE" ] || die "BootOrder first entry is Boot${FINAL_FIRST}, wanted Boot${NEW_ACTIVE}"
    [ "$FINAL_SECOND" = "$NEW_INACTIVE" ] || die "BootOrder second entry is Boot${FINAL_SECOND}, wanted Boot${NEW_INACTIVE}"

    mount -o remount,ro /sys/firmware/efi/efivars 2>/dev/null || true

    echo "[reefy-efi] Committed ${ACTIVE_LABEL} as default with fresh entries: Boot${NEW_ACTIVE},Boot${NEW_INACTIVE}"
}

# ── Commands ──

cmd_fix() {
    fix_entries
}

cmd_status() {
    resolve_slots
    REEFY_A_NUM=$(boot_num_for_label reefy-a)
    REEFY_B_NUM=$(boot_num_for_label reefy-b)
    echo "Active:   ${ACTIVE_LABEL} (Boot${CURRENT_BOOTNUM})"
    echo "Inactive: ${INACTIVE_LABEL} → ${INACTIVE_DEV}"
    echo "reefy-a:   Boot${REEFY_A_NUM:-missing} → $(part_dev "$DISK" 1)"
    echo "reefy-b:   Boot${REEFY_B_NUM:-missing} → $(part_dev "$DISK" 2)"
    efibootmgr 2>/dev/null | grep -E '^Boot(Current|Order|Next)'
}

cmd_confirm() {
    # Commit current boot slot as default.
    # Called by reefy-boot-confirm after health checks pass.
    CURRENT=$(efibootmgr 2>/dev/null | grep '^BootCurrent:' | awk '{print $2}')
    DEFAULT=$(efibootmgr 2>/dev/null | grep '^BootOrder:' | awk '{print $2}' | cut -d, -f1)

    if [ "$CURRENT" = "$DEFAULT" ]; then
        echo "[reefy-efi] Already default slot, nothing to confirm"
        exit 0
    fi

    commit_current_slot_with_fresh_entries
}

cmd_set_next() {
    SLOT="$1"
    case "$SLOT" in
        a) LABEL="reefy-a" ;;
        b) LABEL="reefy-b" ;;
        *) die "Usage: reefy-efi set-next <a|b>" ;;
    esac

    fix_entries
    BOOTNUM=$(boot_num_for_label "$LABEL")
    [ -n "$BOOTNUM" ] || die "Could not find boot entry for ${LABEL}"

    mount -o remount,rw /sys/firmware/efi/efivars 2>/dev/null || true
    efibootmgr -n "$BOOTNUM" 2>/dev/null

    BOOTNEXT_ACTUAL=$(efibootmgr 2>/dev/null | grep '^BootNext:' | awk '{print $2}')
    mount -o remount,ro /sys/firmware/efi/efivars 2>/dev/null || true

    if [ "$BOOTNEXT_ACTUAL" != "$BOOTNUM" ]; then
        die "BootNext not set (got '${BOOTNEXT_ACTUAL}', wanted '${BOOTNUM}')"
    fi

    echo "[reefy-efi] Next boot set to ${LABEL} (Boot${BOOTNUM})"
}

cmd_update() {
    EFI_FILE="$1"
    REBOOT=0
    [ "$2" = "-r" ] && REBOOT=1

    [ -z "$EFI_FILE" ] && die "Usage: reefy-efi update <efi-file> [-r]"
    [ ! -f "$EFI_FILE" ] && die "File not found: $EFI_FILE"
    mountpoint -q "$REEFY_MNT" || die "$REEFY_MNT not mounted"

    # Acquire lock
    LOCK_FILE="/var/lock/reefy-update.lock"
    exec 9>"$LOCK_FILE"
    flock -n 9 || die "Another update is already running"

    resolve_slots
    # Fix all EFI entries first (idempotent, self-healing)
    fix_entries

    # Re-read inactive boot number (may have been recreated by fix_entries)
    INACTIVE_BOOTNUM=$(boot_num_for_label "${INACTIVE_LABEL}")
    if [ -z "${INACTIVE_BOOTNUM}" ]; then
        die "Could not find boot entry for ${INACTIVE_LABEL} - aborting to avoid wrong BootNext"
    fi

    echo "A/B Update:"
    echo "  Active:   ${ACTIVE_LABEL} (Boot${CURRENT_BOOTNUM})"
    echo "  Inactive: ${INACTIVE_LABEL} (Boot${INACTIVE_BOOTNUM})"
    echo "  Target:   ${INACTIVE_DEV}"
    echo "  Source:    ${EFI_FILE}"

    # Defensively clear any stale mount of the inactive slot left behind
    # by a previously-interrupted update. The PRIMARY self-heal: a hard
    # death (SIGKILL, OOM, power loss) skips the EXIT trap below, leaving
    # INACTIVE_DEV mounted; the next mkfs.vfat would then fail with
    # "device busy" and EVERY future update would be stuck. Running this
    # at the start of each update recovers regardless of how the prior
    # one died.
    for mp in $(awk -v d="${INACTIVE_DEV}" '$1==d {print $2}' /proc/mounts); do
        echo "Clearing stale mount of ${INACTIVE_DEV} at ${mp}"
        umount "${mp}" 2>/dev/null || umount -l "${mp}" 2>/dev/null || true
    done

    # Format inactive ESP (fixes vfat corruption)
    echo "Formatting ${INACTIVE_DEV}..."
    mkfs.vfat -F 32 -n "${INACTIVE_LABEL}" "${INACTIVE_DEV}"

    # Write firmware to inactive slot. The EXIT trap releases the temp
    # mount if a later step fails under `set -e` (the belt; the pre-mkfs
    # sweep above is the suspenders for hard deaths that skip traps).
    #
    # The trap body MUST be errexit-safe (wrapped in `{ ...; } || true`):
    # on the SUCCESS path the mount is already released below, so the
    # trap's umount/umount-l both fail and the `||` list returns
    # non-zero. With `set -e` active (see top of file) that would make
    # reefy-efi exit non-zero AFTER a fully successful update - the
    # control plane reads any non-zero as a failed OTA and skips the
    # reboot, so the device silently never updates. `|| true` keeps the
    # cleanup best-effort without poisoning the exit status.
    INACTIVE_MNT=$(mktemp -d)
    trap '{ umount "${INACTIVE_MNT}" 2>/dev/null || umount -l "${INACTIVE_MNT}" 2>/dev/null; rmdir "${INACTIVE_MNT}" 2>/dev/null; } || true' EXIT
    mount "${INACTIVE_DEV}" "${INACTIVE_MNT}"
    cp -a "${REEFY_MNT}/mqtt" "${INACTIVE_MNT}/" 2>/dev/null || true
    # /reefy/ is the namespace for per-device state that must survive
    # A/B firmware updates. New things to preserve = drop them under
    # /reefy/ and they carry over automatically - no edit here needed.
    cp -a "${REEFY_MNT}/reefy" "${INACTIVE_MNT}/" 2>/dev/null || true
    mkdir -p "${INACTIVE_MNT}/EFI/Boot"
    echo "Copying EFI file..."
    cp "$EFI_FILE" "${INACTIVE_MNT}/EFI/Boot/bootx64.efi"
    sync
    umount "${INACTIVE_MNT}"
    rmdir "${INACTIVE_MNT}"

    # Set BootNext for one-shot try
    mount -o remount,rw /sys/firmware/efi/efivars 2>/dev/null || true
    efibootmgr -n "${INACTIVE_BOOTNUM}" 2>/dev/null

    # Verify BootNext is actually set to OUR target (not just present from
    # a previous attempt, and not silently empty which defaults to Boot0000)
    BOOTNEXT_ACTUAL=$(efibootmgr 2>/dev/null | grep '^BootNext:' | awk '{print $2}')
    if [ "${BOOTNEXT_ACTUAL}" = "${INACTIVE_BOOTNUM}" ]; then
        echo "BootNext set to Boot${INACTIVE_BOOTNUM} - safe A/B update"
    else
        # BootNext not supported or wrong: fall back to overwriting active ESP too
        efibootmgr -N 2>/dev/null
        echo "BootNext not set (got '${BOOTNEXT_ACTUAL}', wanted '${INACTIVE_BOOTNUM}'), overwriting active ESP too"
        mount -o remount,rw "$REEFY_MNT"
        cp "$EFI_FILE" "$REEFY_MNT/EFI/Boot/bootx64.efi"
        sync
        mount -o remount,ro "$REEFY_MNT"
    fi

    mount -o remount,ro /sys/firmware/efi/efivars 2>/dev/null || true

    echo "Update complete!"

    if [ "$REBOOT" -eq 1 ]; then
        echo "Rebooting in 3 seconds..."
        sleep 3
        reboot
    fi
}

# ── Main ──

case "${1:-}" in
    fix)      cmd_fix ;;
    status)   cmd_status ;;
    confirm)  cmd_confirm ;;
    set-next) shift; cmd_set_next "$@" ;;
    update)   shift; cmd_update "$@" ;;
    *)        echo "Usage: reefy-efi {fix|update|confirm|set-next|status}"; exit 1 ;;
esac
