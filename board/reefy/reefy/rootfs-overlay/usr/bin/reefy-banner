#!/bin/sh
# Render the Reefy device-state banner to the console login screen and
# the boot log.
#
# The banner used to go only to /dev/kmsg, which production (quiet) boot
# suppresses on the console - so the login screen showed nothing useful.
# This writes it to /etc/issue, which agetty prints right above the
# `login:` prompt regardless of boot-log verbosity, AND to /dev/kmsg for
# the boot log. Run at boot by boot-reefy-init and re-run by
# reefy-banner.path when device state changes, so the console reflects
# current identity / adoption status / addresses (e.g. the bootstrap
# UUID, which is generated after this script first runs).
set -u

PASSWORD_FILE=/mnt/reefy-data/state/device_password
ADOPTED_UUID=/mnt/reefy-data/state/device-uuid
BOOTSTRAP_UUID=/tmp/bootstrap-uuid

# Identity + adoption status: an adopted device has a persistent
# device-uuid; otherwise it is a bootstrap device whose UUID is
# regenerated each boot once the control plane connects.
if [ -f "$ADOPTED_UUID" ]; then
    uuid=$(cat "$ADOPTED_UUID" 2>/dev/null)
    status="adopted"
elif [ -f "$BOOTSTRAP_UUID" ]; then
    uuid=$(cat "$BOOTSTRAP_UUID" 2>/dev/null)
    status="bootstrap (awaiting adoption)"
else
    uuid="(initializing)"
    status="bootstrap (starting)"
fi

# is-active prints the state word (active/inactive/activating/failed)
# even on a non-zero exit, so capture stdout directly - using
# `|| echo unknown` would append a spurious second line. Fall back to
# "unknown" only when there is no output (e.g. systemctl missing).
ctrl=$(systemctl is-active reefy-control 2>/dev/null || true)
[ -n "$ctrl" ] || ctrl=unknown
ver=$(. /etc/os-release 2>/dev/null; printf '%s' "${IMAGE_VERSION:-?}")
slot=$(reefy-efi status 2>/dev/null | awk '/^Active:/ {print $2}')

# Horizontal rule that frames the banner so it stands apart from the
# surrounding kernel boot messages on the console.
RULE="============================================================"

render() {
    echo ""
    echo "$RULE"
    echo ""
    # ASCII wordmark with a branching-coral sprig to its right. @C@ / @R@
    # are colour markers (coral-on / reset) substituted per output
    # surface below - the kmsg path strips them, /etc/issue turns them
    # into real escapes.
    cat <<'ART'
 ____            __          @C@\ / \ /@R@
|  _ \ ___  ___ / _|_   _     @C@Y   Y@R@
| |_) / _ \/ _ \ |_| | | |    @C@|   |@R@
|  _ <  __/  __/  _| |_| |     @C@\ /@R@
|_| \_\___|\___|_|  \__, |      @C@Y@R@
                    |___/       @C@|@R@
ART
    echo ""
    echo "  Welcome to Reefy!   Version: ${ver}   Slot: ${slot:-?}"
    echo ""
    echo "  Hostname : $(hostname)"
    echo "  Identity : ${uuid}"
    echo "  Status   : ${status}"
    echo "  Control  : ${ctrl}"
    echo "  Addresses:"
    ip -o -4 addr list 2>/dev/null | awk '{printf "    %s %s\n", $2, $4}'
    # Dev-only: surface the device password on the console when the
    # operator opted in via the kernel cmdline. Gated identically to the
    # existing kmsg path - production (no flag) never shows it.
    if grep -q 'reefy.dev_shell=1' /proc/cmdline 2>/dev/null; then
        pw=$(cat "$PASSWORD_FILE" 2>/dev/null)
        [ -n "$pw" ] && echo "  DEV login: root / reefy   password: ${pw}"
    fi
    echo ""
    echo "$RULE"
    echo ""
}

out=$(render)

# Boot log: strip the @C@/@R@ colour markers - kmsg/dmesg stay plain
# text (escape codes there would just litter `dmesg` output).
printf '%s\n' "$out" | sed 's/@C@//g; s/@R@//g' > /dev/kmsg 2>/dev/null || true

# Console login screen. Two transforms, in order:
#   1. agetty interprets backslash escapes in /etc/issue, so double every
#      backslash (agetty renders \\ as one \) to keep the ASCII art intact.
#   2. Turn @C@/@R@ into real SGR escapes so the coral sprig renders red,
#      and prepend a one-time OSC palette remap so slot 9 becomes the exact
#      Reefy coral #FF4040. The Linux console caps SGR at 16 colours
#      (truecolor is mapped down), so a palette remap is the only way to hit
#      an exact RGB on a physical monitor. These are Linux-console-only
#      codes; /etc/issue never reaches SSH (sshd sets no Banner), so they
#      cannot corrupt a remote terminal.
c_on=$(printf '\033[91m')
c_off=$(printf '\033[0m')
palette=$(printf '\033]P9FF4040')
{
    printf '%s' "$palette"
    printf '%s\n' "$out" | sed 's/\\/\\\\/g' | sed "s/@C@/$c_on/g; s/@R@/$c_off/g"
} > /etc/issue 2>/dev/null || true
