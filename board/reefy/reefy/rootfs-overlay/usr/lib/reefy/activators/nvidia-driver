#!/bin/sh
set -eu

IFS=:
set -- ${REEFY_ARTIFACT_MOUNTS:?}
unset IFS
COMMON=${1:?missing common NVIDIA layer}
KERNEL_LAYER=${2:?missing NVIDIA kernel layer}
KERNEL_RELEASE=$(uname -r)
MODULE_SOURCE="$KERNEL_LAYER/lib/modules/$KERNEL_RELEASE/extra/nvidia"
FIRMWARE_SOURCE="$COMMON/lib/firmware/nvidia"

[ -d "$MODULE_SOURCE" ]
[ -d "$FIRMWARE_SOURCE" ]
[ -d "$COMMON/usr/lib" ]
[ -x "$COMMON/usr/bin/nvidia-smi" ]
[ -x "$COMMON/usr/bin/nvidia-ctk" ]

bind_read_only() {
    source=$1
    target=$2
    mkdir -p "$target"
    if ! mountpoint -q "$target"; then
        mount --bind "$source" "$target"
        mount -o remount,bind,ro,nodev,nosuid "$target"
    fi
}

bind_read_only "$MODULE_SOURCE" \
    "/lib/modules/$KERNEL_RELEASE/extra/nvidia"
bind_read_only "$FIRMWARE_SOURCE" "/lib/firmware/nvidia"

mkdir -p /usr/lib /usr/bin /etc/vulkan/icd.d \
    /etc/glvnd/egl_vendor.d /etc/cdi

# Reefy intentionally does not ship ldconfig. Put ephemeral links in the
# OverlayFS upper layer so the normal /usr/lib search path resolves the
# provider libraries while the bytes remain in the read-only OCI mount.
# Link the complete, version-matched provider library set. This includes the
# GLVND dispatch libraries and Vulkan/EGL implementation needed by headless
# renderers such as Isaac Sim, not just CUDA and NVML.
for library in "$COMMON"/usr/lib/*.so*; do
    [ -e "$library" ] || continue
    ln -sfn "$library" "/usr/lib/${library##*/}"
done

for binary in nvidia-smi nvidia-ctk nvidia-cdi-hook; do
    if [ -x "$COMMON/usr/bin/$binary" ]; then
        ln -sfn "$COMMON/usr/bin/$binary" "/usr/bin/$binary"
    fi
done
if [ -f "$COMMON/usr/share/vulkan/icd.d/nvidia_icd.json" ]; then
    ln -sfn "$COMMON/usr/share/vulkan/icd.d/nvidia_icd.json" \
        /etc/vulkan/icd.d/nvidia_icd.json
fi
if [ -f "$COMMON/usr/share/glvnd/egl_vendor.d/10_nvidia.json" ]; then
    ln -sfn "$COMMON/usr/share/glvnd/egl_vendor.d/10_nvidia.json" \
        /etc/glvnd/egl_vendor.d/10_nvidia.json
fi

depmod "$KERNEL_RELEASE"
modprobe nvidia
modprobe nvidia-uvm
modprobe nvidia-modeset
modprobe nvidia-drm

# NVIDIA's out-of-tree modules do not always get device nodes from devtmpfs
# on this minimal host. Keep this host-global setup in the trusted Reefy
# activator rather than shipping an executable hook in the downloaded bundle.
NVIDIA_MAJOR=$(awk '/^[0-9]+ nvidiactl$/{print $1}' /proc/devices)
[ -n "$NVIDIA_MAJOR" ]
[ -e /dev/nvidiactl ] || mknod -m 666 /dev/nvidiactl c "$NVIDIA_MAJOR" 255
GPU_INDEX=0
for gpu_dir in /proc/driver/nvidia/gpus/*/; do
    [ -d "$gpu_dir" ] || continue
    [ -e "/dev/nvidia$GPU_INDEX" ] || \
        mknod -m 666 "/dev/nvidia$GPU_INDEX" c "$NVIDIA_MAJOR" "$GPU_INDEX"
    GPU_INDEX=$((GPU_INDEX + 1))
done
if [ "$GPU_INDEX" -eq 0 ] && [ ! -e /dev/nvidia0 ]; then
    mknod -m 666 /dev/nvidia0 c "$NVIDIA_MAJOR" 0
fi
NVIDIA_UVM_MAJOR=$(awk '/^[0-9]+ nvidia-uvm$/{print $1}' /proc/devices || true)
if [ -n "$NVIDIA_UVM_MAJOR" ]; then
    [ -e /dev/nvidia-uvm ] || \
        mknod -m 666 /dev/nvidia-uvm c "$NVIDIA_UVM_MAJOR" 0
    [ -e /dev/nvidia-uvm-tools ] || \
        mknod -m 666 /dev/nvidia-uvm-tools c "$NVIDIA_UVM_MAJOR" 1
fi

nvidia-ctk cdi generate --disable-hook update-ldcache \
    --output=/etc/cdi/nvidia.yaml
nvidia-smi >/dev/null
