#!/bin/sh
set -eu

mkdir -p /etc/cdi
python3 - <<'PY'
import glob
import json


def write(kind, name, paths):
    document = {
        'cdiVersion': '0.6.0',
        'kind': kind,
        'devices': [{
            'name': 'all',
            'containerEdits': {
                'deviceNodes': [{'path': path} for path in paths],
            },
        }],
    }
    with open(f'/etc/cdi/{name}.json.tmp', 'w') as stream:
        json.dump(document, stream, sort_keys=True, indent=2)
    __import__('os').replace(
        f'/etc/cdi/{name}.json.tmp', f'/etc/cdi/{name}.json')


gpu = sorted(glob.glob('/dev/dri/card*') + glob.glob('/dev/dri/renderD*'))
npu = sorted(glob.glob('/dev/accel/accel*'))
if gpu:
    write('intel.com/gpu', 'intel-gpu', gpu)
if npu:
    write('intel.com/npu', 'intel-npu', npu)
PY

test -e /etc/cdi/intel-gpu.json || test -e /etc/cdi/intel-npu.json
