[Unit]
Description=Reefy Log Publisher (journald → MQTT)
After=reefy-control.service
Wants=reefy-control.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/reefy-log-publisher --units reefy-control,reefy-reconciler
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
